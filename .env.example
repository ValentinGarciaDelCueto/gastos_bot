# Copiá este archivo a ".env" y completá los valores. NO subas el .env a git.
# En Railway estas mismas variables se cargan en la pestaña "Variables".

# Token que te dio @BotFather en Telegram.
TELEGRAM_TOKEN=123456:ABC-DEF...

# ID de tu planilla: docs.google.com/spreadsheets/d/ESTO_ES_EL_ID/edit
SHEET_ID=

# Tu user id de Telegram (te lo dice @userinfobot). Solo vos podés cargar
# gastos. Dejalo en 0 para permitir a cualquiera (no recomendado).
ALLOWED_USER_ID=0

# El JSON COMPLETO de la service account de Google, en una sola línea.
# (abrí el .json que descargaste y pegá todo, desde { hasta })
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}
